# Model server
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
MODEL_FILE=Phi-4-mini-instruct-Q4_K_M.gguf
MODEL_NAME=phi-4-mini

# Context allocation, in tokens
LLM_CONTEXT_SIZE=13312
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONTEXT_SAFETY_MARGIN=512

# Paths inside the analyst container
SKILLS_DIR=/app/skills
MINILM_MODEL_PATH=/app/models/all-MiniLM-L6-v2

# Retrieval
ROUTER_TOP_K=5
ROUTER_SEMANTIC_WEIGHT=0.60
ROUTER_NAME_BOOST=3.0
# Applicability checks; false disables activation filtering only.
ROUTER_ACTIVATION_ENABLED=true
ROUTER_MIN_SEMANTIC_SCORE=0.36
ROUTER_MIN_COMBINED_SCORE=0.45
ROUTER_SEMANTIC_ONLY_SCORE=0.65

# HTTP timeouts, in seconds
LLM_TIMEOUT_SECONDS=120
TOKEN_COUNT_TIMEOUT_SECONDS=30

# Pending skill selections
MAX_PENDING_REQUESTS=32
PENDING_REQUEST_TTL_SECONDS=600

# Optional conversation persistence

MEMORY_ENABLED=false
MEMORY_DATABASE_PATH=/app/data/memory.sqlite3
MEMORY_SCOPE=local-operator
# Empty disables age-based pruning; otherwise use a positive day count.
MEMORY_RETENTION_DAYS=
MEMORY_BUSY_TIMEOUT_MS=5000

# Batch 4: selection diversity; false restores Batch 3 selection/ranking.
ROUTER_SELECTION_ENABLED=true
ROUTER_REDUNDANCY_SIMILARITY=0.70
ROUTER_RELATIVE_SCORE_FLOOR=0.80
ROUTER_NOVELTY_WEIGHT=0.25

# Batch 5: bounded long-request retrieval.
ROUTER_LONG_REQUESTS_ENABLED=true
ROUTER_QUERY_CHUNK_TOKENS=192
ROUTER_QUERY_OVERLAP_TOKENS=32
ROUTER_QUERY_MAX_VIEWS=8
ROUTER_QUERY_MAX_DIRECTIVE_VIEWS=3
ROUTER_QUERY_MAX_PROMPT_CHARACTERS=200000

# Durable local job pipeline
SERVICE_LOCAL_TENANT_ID=local
SERVICE_LOCAL_OWNER_ID=local-operator
SERVICE_MAX_WAITING_JOBS=16
SERVICE_OWNER_MAX_WAITING=4
SERVICE_MAX_PENDING_REVIEWS=4
SERVICE_JOB_DEADLINE_SECONDS=600
SERVICE_REVIEW_TTL_SECONDS=600
SERVICE_MAX_PROMPT_CHARACTERS=200000
SERVICE_CONTENT_RETENTION_SECONDS=3600

# Whole-pool accounting reservation; physical VRAM fit requires validation.
SERVICE_INFERENCE_MEMORY_BUDGET_BYTES=6442450944

# Allow worker calls to drain before container termination.
SERVICE_STOP_GRACE_PERIOD=300s
